# macOS junk
.DS_Store

# python
__pycache__/
*.pyc
.venv/

# media / datasets (optional but recommended)
*.mp4

# temporary / cache files
*.log
*.tmp
# HuggingFace upload-staging cache (huggingface_hub upload_large_folder writes one
# .metadata per file into .cache/huggingface/upload/) - regenerable junk, and rsync
# was fanning 50k of them out to every device.
.cache/

# IDEs
.vscode/
.idea/

# Claude Code local settings / project cache — never pushed
.claude/

# Generated training datasets (assembled from media/photos by photo_run_to_dataset.py)
code/ai_models_datasets/series_3_and_4/dataset_real_*/

# Model checkpoints / exports — kept local / hosted on Hugging Face, never pushed to GitHub
*.pth
*.onnx
code/test_files/models/series12_benchmark_onnx/

# Hugging Face publishing artifacts stay local. Dataset/model cards and archives are
# published to Hugging Face, not tracked on the GitHub branch.
*.tar
*.tar.gz
*.tgz
code/ai_models/README.md
code/ai_models/**/README.md
code/ai_models_datasets/**/README.md

# Weights & Biases creates a new local recovery directory for every trainer launch,
# including interrupted attempts. The canonical run history lives in the W&B project.
wandb/
code/ai_models_datasets/**/wandb/
code/ai_models_datasets/**/wandb_runs_local/

# Field data: photo runs (images + label manifests) — hosted on Hugging Face.
# Ignore the contents but keep the folder present via .gitkeep.
media/photos/*
!media/photos/.gitkeep

# Training dataset images (data, not source) — hosted on Hugging Face
code/ai_models_datasets/**/*.jpg

# Dataset folders themselves (images + labels.json) — data, hosted on Hugging Face,
# not GitHub. Ignore the CONTENTS but keep the folder present via .gitkeep so the
# trainer's --roots path exists in a fresh clone. Trainer source and tests live
# one level up and stay tracked; dataset cards remain Hub-only by policy above.
code/ai_models_datasets/series_1_and_2/sidewalkpilot_dataset/*
code/ai_models_datasets/series_3_and_4/sidewalkpilot_dataset/*
!code/ai_models_datasets/series_1_and_2/sidewalkpilot_dataset/.gitkeep
!code/ai_models_datasets/series_3_and_4/sidewalkpilot_dataset/.gitkeep

# runtime logs now live in ~/logs (outside the repo)
logs/
